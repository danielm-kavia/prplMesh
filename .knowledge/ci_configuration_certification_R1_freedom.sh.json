{"is_source_file": true, "format": "shell script / Bash", "description": "This file is a Bash shell script used for configuring a device, including starting/stopping services, setting network parameters, configuring Wi-Fi interfaces, and setting up SSH access, primarily for certification or testing purposes.", "external_files": ["/etc/config/ssh_server/*_key"], "external_methods": ["syslog-ng-ctl reload", "service ssh-server stop", "service tr181-firewall stop", "service amx-processmonitor stop", "ubus wait_for", "ba-cli", "grep -Eq", "echo", "sleep", "cp", "grep -q", "head", "mv", "tail", "eval"], "published": [], "classes": [], "methods": [], "calls": ["syslog-ng-ctl reload", "service ssh-server stop", "service tr181-firewall stop", "service amx-processmonitor stop", "ubus wait_for IP.Interface", "ba-cli DHCPv4Client.Client.wan.Enable=0", "ba-cli DHCPv6Client.Client.wan.Enable=0", "ba-cli DHCPv4Server.Enable=0", "ba-cli DHCPv6Server.Enable=0", "ba-cli IP.Interface.wan.IPv4Address.primary.{Alias=\"primary\", AddressingType=\"Static\"}", "ba-cli 'IP.Interface.wan.IPv4Address.primary.{IPAddress=\"192.168.250.150\", SubnetMask=\"255.255.255.0\", AddressingType=\"Static\", Enable=1}'", "ba-cli IP.Interface.wan.IPv4Enable=1", "ba-cli \"IP.Interface.[Name == \\\"br-lan\\\"].IPv4Address.lan.IPAddress=192.165.100.150\"", "ba-cli \"Bridging.Bridge.[Alias == \\\"lan\\\"].Port.[Name == \\\"lan4\\\"].Enable=0\"", "ba-cli \"Device.Ethernet.Interface.[Name == \\\"lan4\\\"].Enable=0\"", "ba-cli \"Device.Ethernet.Interface.[Name == \\\"lan4\\\"].Enable=1\"", "ba-cli \"Bridging.Bridge.[Alias == \\\"lan\\\"].Port.[Name == \\\"lan4\\\"].Enable=1\"", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.Enable=0\"", "sleep 5", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.ManagementMode=\\\"Multi-AP-Agent\\\"\"", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.CertificationMode=1\"", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.Enable=1\"", "sleep 5", "if ba-cli \"X_PRPLWARE-COM_Agent.Configuration.?\" | grep -Eq \"No data found|ERROR\"; then", "echo \"Prplmesh agent is not running\"", "else", "echo \"Setting prplMesh BackhaulWireInterface over DM\"", "ba-cli X_PRPLWARE-COM_Agent.Configuration.BackhaulWireInterface=\"lan4\"", "fi", "ubus call \"WiFi.Radio\" _set '{ \"rel_path\": \".[OperatingFrequencyBand == \\\"2.4GHz\\\"].\", \"parameters\": { \"Enable\": \"true\" } }'", "ubus call \"WiFi.Radio\" _set '{ \"rel_path\": \".[OperatingFrequencyBand == \\\"5GHz\\\"].\", \"parameters\": { \"Enable\": \"true\" } }'", "ba-cli WiFi.Radio.*.RegulatoryDomain=\"US\"", "ba-cli WiFi.AccessPoint.*.IEEE80211kEnabled=0", "ubus-cli WiFi.AccessPoint.*.MultiAPProfile=3", "ubus-cli \"WiFi.AccessPoint.*.MBOEnable=1\"", "ba-cli \"WiFi.Radio.[OperatingFrequencyBand == \\\"2.4GHz\\\"].OperatingChannelBandwidth=20MHz\"", "ba-cli \"WiFi.Radio.[OperatingFrequencyBand == \\\"5GHz\\\"].OperatingChannelBandwidth=20MHz\"", "ba-cli WiFi.AccessPoint.*.SSIDAdvertisementEnabled=1", "iptables -P INPUT ACCEPT", "killall -9 dropbear", "dropbear -F -T 10 -p192.168.250.150:22 &", "cp /etc/config/ssh_server/*_key /etc/dropbear/", "grep -q \"$boot_cmd\" \"$bootscript\"", "head -n -2 \"$bootscript\"", "echo \"$boot_cmd\"", "tail -2 \"$bootscript\"", "mv btscript.tmp \"$bootscript\"", "eval \"$start_ssh_commands\""], "search-terms": ["certification", "prplMesh", "Wireless setup", "device configuration", "SSH setup", "WiFi configuration", "network services management", "backhaul configuration"], "state": 2, "file_id": 411, "knowledge_revision": 3294, "git_revision": "0920cae0d3eb76c7ca02eb86f074439a87bfe7da", "hash": "34fffa22236d2c8f6781a83a7c0b04de", "format-version": 4, "code-base-name": "prplMesh", "filename": "ci/configuration/certification/R1/freedom.sh", "revision_history": [{"3294": "0920cae0d3eb76c7ca02eb86f074439a87bfe7da"}]}