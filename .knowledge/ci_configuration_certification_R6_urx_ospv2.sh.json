{"is_source_file": true, "format": "Shell script", "description": "This file is a shell script used for configuring and managing network services, interfaces, and system settings on a device. It includes commands to disable or enable services, configure network interfaces, setup backhaul interfaces, manage WiFi settings, and set up SSH access.", "external_files": ["/etc/config/ssh_server/*_key"], "external_methods": ["syslog-ng-ctl", "service", "rm", "grep", "echo", "ba-cli", "sleep", "iw-mxl", "cp", "grep"], "published": [], "classes": [], "methods": [], "calls": ["syslog-ng-ctl reload", "service ssh-server stop", "service tr181-firewall stop", "service amx-processmonitor stop", "ubus wait_for IP.Interface", "ba-cli DHCPv4Client.Client.wan.Enable=0", "ba-cli DHCPv6Client.Client.wan.Enable=0", "ba-cli DHCPv4Server.Enable=0", "ba-cli DHCPv6Server.Enable=0", "grep -Eq \"No data found|ERROR\"", "echo \"Adding IP address $IP\"", "ba-cli 'IP.Interface.wan.IPv4Address.+{Alias=\"primary\", AddressingType=\"Static\"}'", "ba-cli 'IP.Interface.wan.IPv4Address.primary.{IPAddress=\"192.168.250.160\", SubnetMask=\"255.255.255.0\", AddressingType=\"Static\", Enable=1}'", "ba-cli IP.Interface.wan.IPv4Enable=1", "ba-cli \"IP.Interface.[Name == \\\"br-lan\\\"].IPv4Address.lan.IPAddress=192.165.100.160\"", "ba-cli \"Bridging.Bridge.[Alias == \\\"lan\\\"].Port.[Name == \\\"eth0_2\\\"].Enable=0\"", "ba-cli \"Device.Ethernet.Interface.[Name == \\\"eth0_2\\\"].Enable=0\"", "ba-cli \"Device.Ethernet.Interface.[Name == \\\"eth0_2\\\"].Enable=1\"", "ba-cli \"Bridging.Bridge.[Alias == \\\"lan\\\"].Port.[Name == \\\"eth0_2\\\"].Enable=1\"", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.Enable=0\"", "sleep 5", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.ManagementMode=\\\"Multi-AP-Agent\\\"\"", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.CertificationMode=1\"", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.Enable=1\"", "sleep 5", "ba-cli \"X_PRPLWARE-COM_Agent.Configuration.?\"", "echo \"Prplmesh agent is not running\"", "echo \"Setting prplMesh BackhaulWireInterface over DM\"", "ba-cli X_PRPLWARE-COM_Agent.Configuration.BackhaulWireInterface=\"eth0_2\"", "ba-cli WiFi.Radio.*.RegulatoryDomain=\"US\"", "ba-cli \"WiFi.set_trace_zone(zone=genHapd, level=500)\"", "ba-cli \"WiFi.set_trace_zone(zone=hapdAP, level=500)\"", "ba-cli \"WiFi.set_trace_zone(zone=chanMgt, level=500)\"", "ba-cli \"WiFi.set_trace_zone(zone=wpaCtrl, level=500)\"", "ba-cli \"WiFi.set_trace_zone(zone=mxlRad, level=500)\"", "printf \"protected\\nDevice.WiFi.Vendor.ModuleMode.CertificationMode=1\\nexit\\n\" | ba-cli", "ba-cli WiFi.Radio.*.Enable=1", "ba-cli \"WiFi.SSID.[Alias == \\\"VAP2G0PRIV\\\"].Enable=1\"", "ba-cli \"WiFi.SSID.[Alias == \\\"VAP5G0PRIV\\\"].Enable=1\"", "sleep 10", "iw-mxl dev wlan0 iwlwav sCoCPower 0 1 1", "sleep 1", "iw-mxl dev wlan2 iwlwav sCoCPower 0 1 1", "sleep 5", "cp /etc/config/ssh_server/*_key /etc/dropbear/", "grep -q \"$boot_cmd\" \"$bootscript\"", "head -n -2 \"$bootscript\"", "echo \"$boot_cmd\"", "tail -2 \"$bootscript\"", "mv btscript.tmp \"$bootscript\"", "eval \"$start_ssh_commands\""], "search-terms": ["prplMesh", "uci", "network configuration", "WiFi setup", "SSH setup", "backhaul interface", "device configuration", "network services", "shell script"], "state": 2, "file_id": 409, "knowledge_revision": 3408, "git_revision": "233bb84e7a97041d08462a83772e480bee2ac90b", "hash": "7934786a3f0e477ee40f66105e4e84a6", "format-version": 4, "code-base-name": "prplMesh", "filename": "ci/configuration/certification/R6/urx_ospv2.sh", "revision_history": [{"3408": "233bb84e7a97041d08462a83772e480bee2ac90b"}]}