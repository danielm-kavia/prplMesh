{"is_source_file": true, "format": "Shell Script", "description": "This is a shell script used for initializing and configuring network services and interfaces on a device, likely during system startup or testing. It manages services like UPnP, SSH, firewall, DHCP, and Wi-Fi configuration, as well as network interface setup and SSH key handling.", "external_files": ["/etc/config/ssh_server/*_key", "/etc/dropbear/", "/etc/rc.local", "/etc/amx/wld/wld_defaults.odl.uc"], "external_methods": ["syslog-ng-ctl", "service", "ubus", "ba-cli", "grep", "echo", "killall", "dropbear", "cp", "head", "tail", "mv"], "published": [], "classes": [], "methods": [], "calls": ["syslog-ng-ctl reload", "service tr181-upnp stop", "service obuspa stop", "service ssh-server stop", "service tr181-firewall stop", "service amx-processmonitor stop", "ubus wait_for IP.Interface", "ba-cli DHCPv4Client.Client.wan.Enable=0", "ba-cli DHCPv6Client.Client.wan.Enable=0", "ba-cli DHCPv4Server.Enable=0", "ba-cli DHCPv6Server.Enable=0", "ba-cli \"IP.Interface.[Name == \\\"br-lan\\\"].IPv4Address.lan.IPAddress=192.168.1.180\"", "ba-cli \"Bridging.Bridge.[Alias == \\\"lan\\\"].Port.[Name == \\\"lan0\\\"].Enable=0\"", "ba-cli \"Device.Ethernet.Interface.[Name == \\\"lan0\\\"].Enable=0\"", "ba-cli \"Device.Ethernet.Interface.[Name == \\\"lan0\\\"].Enable=1\"", "ba-cli \"Bridging.Bridge.[Alias == \\\"lan\\\"].Port.[Name == \\\"lan0\\\"].Enable=1\"", "sleep 5", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.ManagementMode=\\\"Multi-AP-Controller-and-Agent\\\"\"", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.CertificationMode=1\"", "ba-cli \"X_PRPLWARE-COM_ProcessManager.PrplMesh.Enable=1\"", "sleep 5", "echo \"Prplmesh agent is not running\"", "echo \"Setting prplMesh BackhaulWireInterface over DM\"", "ba-cli X_PRPLWARE-COM_Agent.Configuration.BackhaulWireInterface=\"lan0\"", "ba-cli \"WiFi.Radio.[OperatingFrequencyBand == \\\"2.4GHz\\\"].Enable=1\"", "ba-cli \"WiFi.Radio.[OperatingFrequencyBand == \\\"5GH